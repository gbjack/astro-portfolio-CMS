    </div>

    <div class="flex flex-col md:grow text-center md:text-left">
      <h1
        class="text-[55px] leading-[0.9] tracking-tight sm:text-6xl md:text-7xl lg:text-9xl font-light text-black"
        data-module="ImageReveal"
      >
        Selected
        <br />
        works
      </h1>
    </div>
  </section>
</div>
