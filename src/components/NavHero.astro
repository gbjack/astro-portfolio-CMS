---
// No props needed
---

<!-- Full Viewport Wrapper -->
<div class="flex flex-col min-h-svh w-full">
  <!-- Navbar -->
  <nav
    class="flex flex-wrap justify-between items-center w-full max-w-360 mx-auto px-6 md:px-10 py-4 sm:py-5 shrink"
  >
    <!-- Left: Name & Title -->
    <div class="flex items-center gap-2 text-base sm:text-lg tracking-tight">
      <span class="font-bold text-black">Jack Tan</span>
      <span class="text-gray-300 font-light">|</span>
      <span class="font-normal text-black tracking-wide">Digital Creative</span>
    </div>

    <!-- Right: Social Links -->
    <div
      class="flex items-center gap-3 sm:gap-5 text-base sm:text-lg font-medium"
    >
      <a href="#contactForm" class="text-black hover:opacity-70 transition-opacity"
        >Contact</a
      >
      <a
        href="https://www.linkedin.com/in/jackscreativework"
        target="_blank"
        class="text-black hover:opacity-70 transition-opacity">Linkedin</a
      >
    </div>
  </nav>

  <section
    class="flex flex-col md:flex-row items-center justify-center flex-1 w-full max-w-360 mx-auto px-6 md:px-10 gap-10 md:gap-20 lg:gap-30"
  >
    <div class="md:grow">
      <!--?xml version="1.0" encoding="UTF-8"?-->
      <svg
        class="w-36 h-auto mx-auto"
        id="Layer_1"
        data-name="Layer 1"
        xmlns="http://www.w3.org/2000/svg"
        version="1.1"
        viewBox="0 0 30 30"
        data-module="ImageReveal"
      >
        <defs>
          <style>
            .cls-1 {
              fill: none;
            }
            .cls-1,
            .cls-2 {
              stroke-width: 0px;
            }
            .cls-2 {
              fill: #000;
            }
          </style>
        </defs>
        <path
          class="cls-2"
          d="M2.5,25.9c0,1.8,1.5,3.3,3.3,3.3s3.3-1.5,3.3-3.3V4.1c0-1.8-1.5-3.3-3.3-3.3s-3.3,1.5-3.3,3.3v21.9h0Z"
        ></path>
        <path
          class="cls-2"
          d="M11.7,25.9c0,1.8,1.5,3.3,3.3,3.3s3.3-1.5,3.3-3.3V4.1c0-1.8-1.5-3.3-3.3-3.3s-3.3,1.5-3.3,3.3v21.9h0Z"
