        ></path>
        <rect class="cls-1" y="0" width="30" height="30" rx="9.6" ry="9.6"
        ></rect>
        <g>
          <path
            class="cls-2"
            d="M20.9,13.7c0,.7-.6,1.3-1.3,1.3.7,0,1.3.6,1.3,1.3,0-.7.6-1.3,1.3-1.3-.7,0-1.3-.6-1.3-1.3Z"
          ></path>
          <path
