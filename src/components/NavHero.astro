          ></path>
        </g>
        <g>
          <path
            class="cls-2"
            d="M11.7,23.7c0,.7-.6,1.3-1.3,1.3.7,0,1.3.6,1.3,1.3,0-.7.6-1.3,1.3-1.3-.7,0-1.3-.6-1.3-1.3Z"
