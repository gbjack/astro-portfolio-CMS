---
import Layout from "../layouts/Layout.astro";
import NavHero from "../components/NavHero.astro";
import Form from "../components/Form.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";

// --- 1. CONFIGURATION ---
const TABLE_ID = 1090925;
const API_TOKEN = import.meta.env.BASEROW_API_TOKEN;

interface BaserowProject {
	Client: string;
	Intro: string;
	Role: string;
	"Core Deliverables": string;
	"Project Image Gallery"?: { url: string }[] | null;
	"Layout Pattern"?: string;
	"Video Gallery"?: { url: string }[] | null;
	"YouTube Link"?: string | null;
}

let projects: BaserowProject[] = [];

// --- 2. FETCH ---
if (!API_TOKEN) {
	console.error("❌ API_TOKEN is undefined. Check your .env file.");
} else {
	try {
		const response = await fetch(
			`https://api.baserow.io/api/database/rows/table/${TABLE_ID}/?user_field_names=true`,
			{
				headers: {
					Authorization: `Token ${API_TOKEN}`,
				},
			},
		);

		if (response.ok) {
			const data = await response.json();
			projects = data.results || [];
		} else {
			console.error(`Baserow Error: ${response.status}`);
		}
	} catch (error) {
		console.error("Network error:", error);
	}
}

// --- 3. HELPER FUNCTIONS ---
function getYouTubeEmbedUrl(url: string): string {
	if (!url) return "";
	if (url.includes("watch?v=")) {
		return url.replace("watch?v=", "embed/");
	}
	if (url.includes("youtu.be/")) {
		const videoId = url.split("youtu.be/")[1]?.split("?")[0];
		return `https://www.youtube.com/embed/${videoId}`;
	}
	return url;
}

// --- 4. PAGINATION ---
const ITEMS_PER_PAGE = 5;
const currentPage = Number(Astro.url.searchParams.get("page")) || 1;
const totalProjects = projects.length;
const totalPages = Math.ceil(totalProjects / ITEMS_PER_PAGE);
const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
const endIndex = startIndex + ITEMS_PER_PAGE;
const paginatedProjects = projects.slice(startIndex, endIndex);
---

<Layout>
	<NavHero />
	<main
		class="min-h-screen w-full max-w-360 mx-auto px-6 md:px-10 py-12 md:py-20"
		id="top"
	>
		{
			paginatedProjects.length > 0 ? (
				paginatedProjects.map((project: BaserowProject) => {
					const deliverables =
						project["Core Deliverables"]?.split("\n") || [];
					const images = project["Project Image Gallery"] || [];
					const videos = project["Video Gallery"] || [];
					const youtubeUrl = project["YouTube Link"];

					// Get layout pattern, default to "2"
					const patternStr = project["Layout Pattern"]?.trim() || "2";
					const pattern = patternStr
						.split(",")
						.map((p) => parseInt(p.trim()));

					// Function to build rows from items
					function buildRows(items: any[]) {
						let imgIndex = 0;
						const rows = [];

						for (const cols of pattern) {
							const count = cols === 1 ? 1 : 2;
							const rowItems = items.slice(
								imgIndex,
								imgIndex + count,
							);
							if (rowItems.length > 0) {
								rows.push({ items: rowItems, cols });
								imgIndex += count;
							}
						}

						// Handle remaining items
						while (imgIndex < items.length) {
							const lastCols = pattern[pattern.length - 1] || 2;
							const count = lastCols === 1 ? 1 : 2;
							const rowItems = items.slice(
								imgIndex,
								imgIndex + count,
							);
							if (rowItems.length > 0) {
								rows.push({ items: rowItems, cols: lastCols });
								imgIndex += count;
							}
						}

						return rows;
					}

					const imageRows = buildRows(images);
					const videoRows = buildRows(videos);

					return (
						<div class="mb-30 md:mb-40 lg:mb-50 last:mb-0">
							{/* --- HEADER --- */}
							<div
								class="flex flex-col lg:flex-row justify-between items-start mb-10 gap-10 lg:gap-20"
								data-module="ImageReveal"
							>
								<div class="w-full grow">
									<h1 class="font-['Poppins',sans-serif] text-[3.5rem] leading-[80%] font-normal tracking-[-3px] text-black">
										{project["Client"]}
									</h1>
									<p class="text-[1.25rem] leading-normal text-black mt-6 max-w-3xl">
										{project.Intro}
									</p>
								</div>
								<div class="w-full md:w-fit grow-0 text-left md:text-left md:items-start">
									<p class="text-[1.25rem] font-bold mt-0 text-black text-nowrap">
										Role: {project["Role"]}
									</p>
									<div class="text-[1rem] leading-normal text-black text-nowrap mt-2 space-y-1">
										{deliverables.map((line: string) => (
											<p>{line}</p>
										))}
									</div>
								</div>
							</div>

							{/* --- IMAGE GALLERY (Mixed Layout) --- */}
							{imageRows.length > 0 &&
								imageRows.map((row) => (
									<div
										class={`grid ${row.cols === 1 ? "grid-cols-1" : "grid-cols-1 md:grid-cols-2"} gap-4 md:gap-6 mb-6`}
									>
										{row.items.map(
											(img: { url: string }) => (
												<div class="img-wrapper rounded-[1.25rem] overflow-hidden border border-gray-200">
													<Image
														src={img.url}
														alt={project["Client"]}
														width={
															row.cols === 1
																? 1200
																: 800
														}
														height={
															row.cols === 1
																? 750
																: 500
														}
														loading="lazy"
														format="webp"
														data-module="ImageReveal"
														class="w-full h-full object-cover"
													/>
												</div>
											),
										)}
									</div>
								))}

							{/* --- VIDEO GALLERY (Mixed Layout) --- */}
							{videoRows.length > 0 &&
								videoRows.map((row) => (
									<div
										class={`grid ${row.cols === 1 ? "grid-cols-1" : "grid-cols-1 md:grid-cols-2"} gap-4 md:gap-6 mb-6`}
									>
										{row.items.map(
											(video: { url: string }) => (
												<div class="img-wrapper rounded-[1.25rem] overflow-hidden bg-black border border-gray-200">
													<video
														src={video.url}
														class="w-full h-full object-cover"
														autoplay
														muted
														loop
														playsinline
														preload="metadata"
														data-module="ImageReveal"
													/>
												</div>
											),
										)}
									</div>
								))}

							{/* --- YOUTUBE --- */}
							{youtubeUrl && (
								<div class="relative w-full pt-[56.25%] rounded-[1.25rem] overflow-hidden bg-black border border-gray-200">
									<iframe
										class="absolute inset-0 w-full h-full border-0"
										src={getYouTubeEmbedUrl(youtubeUrl)}
										title={`${project["Client"]} Video`}
										allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
										allowfullscreen
										loading="lazy"
										data-module="ImageReveal"
									/>
								</div>
							)}
						</div>
					);
				})
			) : (
				<p class="text-gray-500">No projects found.</p>
			)
		}

		<div class="flex justify-center items-center">
			<a
				href="#top"
				aria-label="Go to Top"
				class="px-2 py-2 rounded hover:bg-gray-300 text-gray-600"
			>
				<svg
					width="20"
					height="20"
					viewBox="0 0 24 24"
					fill="none"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path
						d="M18 15L12 9L6 15"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</a>
		</div>

		{/* --- PAGINATION --- */}
		{
			totalPages > 1 && (
				<div class="flex justify-center items-center gap-2">
					<a
						href={
							currentPage > 1 ? `/?page=${currentPage - 1}#top` : "#"
						}
						aria-label="Go to previous page"
						class={`px-2 py-2 rounded hover:bg-gray-300 text-gray-600 ${currentPage === 1 ? "opacity-50 pointer-events-none" : ""}`}
					>
						<svg
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							xmlns="http://www.w3.org/2000/svg"
						>
							<path
								d="M15 18L9 12L15 6"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							/>
						</svg>
					</a>
					{Array.from({ length: totalPages }, (_, i) => i + 1).map(
						(pageNum) => (
							<a
								href={`/?page=${pageNum}#top`}
								class={`px-3 py-1.5 rounded ${
									pageNum === currentPage
										? "bg-black text-white"
										: "hover:bg-gray-300 text-gray-600"
								}`}
							>
								{pageNum}
							</a>
						),
					)}
					<a
						href={
							currentPage < totalPages
								? `/?page=${currentPage + 1}#top`
								: "#"
						}
						aria-label="Go to Next Page"
						class={`px-2 py-2 rounded hover:bg-gray-300 text-gray-600 ${currentPage === totalPages ? "opacity-50 pointer-events-none" : ""}`}
					>
						<svg
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							xmlns="http://www.w3.org/2000/svg"
						>
							<path
								d="M9 18L15 12L9 6"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							/>
						</svg>
					</a>
				</div>
			)
		}
	</main>
	<section class="bg-gray-100 px-6 md:px-10 py-12 md:py-20">
		<div class="w-full max-w-360 mx-auto">
			<Form />
		</div>
	</section>
	<Footer />
</Layout>
